          "tipWhat": "Record customer acceptance of the quote.", "tipWho": "Sales / office", "tipWhere": "Sales desk", "tipPitfall": "Accepting the wrong quote version.", "stub": false, "helpKey": "sales.desk" },
        { "stepNo": 4, "name": "Confirm sales order", "stepCode": "sales.order.confirm", "deskHint": "/sales", "outcomeStatus": "CONFIRMED", "actorHint": "HUMAN", "predecessorStepNo": 3,
          "tipWhat": "Confirm the sales order from the accepted quote.", "tipWho": "Sales / ops", "tipWhere": "Sales desk", "tipPitfall": "Confirming before acceptance skips the commercial handshake.", "stub": false, "helpKey": "sales.desk" },
        { "stepNo": 5, "name": "Optional draft invoice", "stepCode": "sales.order.invoice", "deskHint": "/finance/invoices", "outcomeStatus": "DRAFT", "actorHint": "SYSTEM", "predecessorStepNo": 4,
