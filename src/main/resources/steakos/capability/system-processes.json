{
  "version": 1,
  "processes": [
    {
      "processCode": "SCM_PO_FULFILL",
      "name": "Purchase order",
      "description": "Happy path: create PO → send → confirm receipt → payable → payment → vendor paid. Implemented on the SCM desk.",
      "processKind": "SYSTEM",
      "processStatus": "ACTIVE",
      "versionLabel": "1.0",
      "steps": [
        { "stepNo": 1, "name": "Create purchase order (draft)", "stepCode": "scm.po.create", "deskHint": "/scm", "outcomeStatus": "DRAFT", "actorHint": "HUMAN" },
        { "stepNo": 2, "name": "Send purchase order", "stepCode": "scm.po.send", "deskHint": "/scm", "outcomeStatus": "SENT", "actorHint": "HUMAN", "predecessorStepNo": 1 },
        { "stepNo": 3, "name": "Confirm receipt", "stepCode": "scm.po.receive", "deskHint": "/scm", "outcomeStatus": "RECEIVED", "actorHint": "HUMAN", "predecessorStepNo": 2 },
        { "stepNo": 4, "name": "Payable item", "stepCode": "scm.po.payable", "deskHint": "/finance/payables", "outcomeStatus": "PAYABLE", "actorHint": "SYSTEM", "predecessorStepNo": 3 },
        { "stepNo": 5, "name": "Payment run / pay", "stepCode": "scm.po.pay", "deskHint": "/finance/payables", "outcomeStatus": "PAID", "actorHint": "HUMAN", "predecessorStepNo": 4 },
        { "stepNo": 6, "name": "Confirmed vendor payment", "stepCode": "scm.po.paid", "deskHint": "/finance/payables", "outcomeStatus": "CLOSED", "actorHint": "SYSTEM", "predecessorStepNo": 5 }
      ]
    },
    {
      "processCode": "SCM_MAKE_TO_STOCK",
      "name": "Make to stock",
      "description": "Release production → start → complete (OPEN lot) → quality check → PASS releases stock. Shop floor.",
      "processKind": "SYSTEM",
      "processStatus": "ACTIVE",
      "versionLabel": "1.0",
      "steps": [
        {
          "stepNo": 1, "name": "Release production order", "stepCode": "scm.prod.release",
          "deskHint": "/scm/shopfloor", "outcomeStatus": "RELEASED", "actorHint": "HUMAN",
          "tipWhat": "Release a draft production order so the floor can start it.",
          "tipWho": "Shop floor / planner", "tipWhere": "Shop floor → Production",
          "tipPitfall": "Completing without release skips the planned sequence but is still allowed from DRAFT.",
          "stub": false, "helpKey": "scm.shopfloor"
        },
        {
          "stepNo": 2, "name": "Start production", "stepCode": "scm.prod.start",
          "deskHint": "/scm/shopfloor", "outcomeStatus": "IN_PROGRESS", "actorHint": "HUMAN", "predecessorStepNo": 1,
          "tipWhat": "Mark the order in progress on the floor.",
          "tipWho": "Shop floor", "tipWhere": "Shop floor → Production",
          "tipPitfall": "Starting a cancelled order is blocked.",
          "stub": false, "helpKey": "scm.shopfloor"
        },
        {
          "stepNo": 3, "name": "Complete production (create lot)", "stepCode": "scm.prod.complete",
          "deskHint": "/scm/shopfloor", "outcomeStatus": "COMPLETED", "actorHint": "HUMAN", "predecessorStepNo": 2,
          "tipWhat": "Finish the make order. For goods this creates an OPEN lot — stock is not posted yet.",
          "tipWho": "Shop floor", "tipWhere": "Shop floor → Production",
          "tipPitfall": "Expecting on-hand to rise at complete — it rises only after QA PASS.",
          "stub": false, "helpKey": "scm.shopfloor"
        },
        {
          "stepNo": 4, "name": "Quality check (PASS / FAIL / HOLD)", "stepCode": "scm.qa.check",
          "deskHint": "/scm/shopfloor", "outcomeStatus": "RELEASED", "actorHint": "HUMAN", "predecessorStepNo": 3,
          "tipWhat": "Inspect the lot. PASS releases quantity into stock; FAIL rejects; HOLD quarantines.",
          "tipWho": "Quality / shop floor", "tipWhere": "Shop floor → Quality",
          "tipPitfall": "Skipping QA leaves finished goods invisible in on-hand.",
          "stub": false, "helpKey": "scm.shopfloor"
        },
        {
          "stepNo": 5, "name": "Stock available (on hand)", "stepCode": "scm.inv.available",
          "deskHint": "/scm/shopfloor", "outcomeStatus": "POSTED", "actorHint": "SYSTEM", "predecessorStepNo": 4,
          "tipWhat": "After PASS, a PRODUCTION stock move posts and on-hand increases.",
          "tipWho": "System", "tipWhere": "Shop floor → Inventory",
          "tipPitfall": "Manual lots for stock already on hand do not post a second receipt on PASS.",
          "stub": false, "helpKey": "scm.shopfloor"
        }
      ]
    },
    {
